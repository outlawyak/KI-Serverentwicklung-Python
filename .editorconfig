# EditorConfig: https://editorconfig.org
# Python settings mirror [tool.ruff] in pyproject.toml.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88

[*.{toml,sql}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[uv.lock]
# Generated by uv, do not reformat.
indent_style = unset
indent_size = unset
